# Google Cloud Vertex AI Configuration
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=<<Your Vertex-AI enabled GCP Project Name>>
GOOGLE_CLOUD_LOCATION=<<Your Vertex-AI enabled GCP Project Region. Ex: us>>

# Model & Database Configuration
ADK_MODEL_NAME=gemini-3.5-flash
DUCKDB_PATH=data/analytics.duckdb
DUCKDB_READ_ONLY=true

# Security Guardrails
MAX_QUERY_LIMIT=1000
ALLOWED_TABLES=["api_error_logs", "country_mappings"]